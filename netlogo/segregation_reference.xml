<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment
      name="segregation-reference"
      repetitions="30"
      sequentialRunOrder="true"
      runMetricsEveryStep="false"
      timeLimit="10000">
    <setup>setup</setup>
    <go>go</go>
    <metrics>
      <metric>ticks</metric>
      <metric>count turtles</metric>
      <metric>percent-similar</metric>
      <metric>percent-unhappy</metric>
      <metric>count turtles with [not happy?]</metric>
    </metrics>
    <constants>
      <enumeratedValueSet variable="visualization">
        <value value="&quot;old&quot;"></value>
      </enumeratedValueSet>
      <enumeratedValueSet variable="density">
        <value value="70"></value>
        <value value="80"></value>
        <value value="90"></value>
        <value value="95"></value>
      </enumeratedValueSet>
      <steppedValueSet variable="%-similar-wanted" first="15" step="5" last="70">
      </steppedValueSet>
    </constants>
  </experiment>
</experiments>
