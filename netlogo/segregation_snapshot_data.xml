<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment
      name="segregation-snapshot-data"
      repetitions="1"
      sequentialRunOrder="true"
      runMetricsEveryStep="false"
      timeLimit="10000">
    <setup>setup</setup>
    <go>go</go>
    <metrics>
      <metric>ticks</metric>
      <metric>percent-similar</metric>
      <metric>percent-unhappy</metric>
      <metric>[(list xcor ycor color)] of turtles</metric>
    </metrics>
    <constants>
      <enumeratedValueSet variable="visualization">
        <value value="&quot;old&quot;"></value>
      </enumeratedValueSet>
      <enumeratedValueSet variable="density">
        <value value="80"></value>
        <value value="95"></value>
      </enumeratedValueSet>
      <enumeratedValueSet variable="%-similar-wanted">
        <value value="30"></value>
        <value value="70"></value>
      </enumeratedValueSet>
    </constants>
  </experiment>
</experiments>
